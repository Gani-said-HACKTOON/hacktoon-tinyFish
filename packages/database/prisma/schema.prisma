generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma/client"
}

datasource db {
  provider = "postgresql"
}

model User {
  id       Int    @id @default(autoincrement())
  username String 
  email    String @unique
  password String
}

model refresh_token{
  id Int @id @default(autoincrement())
  user_id Int @unique
  token String
  expired_at DateTime
  created_at DateTime
}