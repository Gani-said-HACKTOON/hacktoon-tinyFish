generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma/client"
}

datasource db {
  provider = "postgresql"
}

model User{
  id       Int    @id @default(autoincrement())
  first_name String 
  last_name String
  company_name String
  email    String @unique
  password String
}

model refreshToken{
  id Int @id @default(autoincrement())
  user_id Int @unique
  token String
  expired_at DateTime
  created_at DateTime
}

model userData{
  id Int @id @default(autoincrement())
  user_id Int @unique
  regulations String
  risk_analysis String
  compliance_reports String
  policy_enforcements String
  activity_log String
  report_data String

}